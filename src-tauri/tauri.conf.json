{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cfop-tutorial",
  "version": "0.1.2",
  "identifier": "com.jimwel.cfop-tutorial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cfop-tutorial",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRjM3NkJDNkI4QUEzRTYKUldUbW80cHJ2SGJ6ODZWUW9ZUGpLYjZEV1luL01BbDVFQUF6UmxmYWlRazM0b3NEeHR2YUt6dFYK",
      "endpoints": [
        "https://github.com/jimweldev/cfop-tutorial/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
